[Unit]
Description=Kurage Voice Pro API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/exdirect/kuragevp
Environment=KURAGEVP_PORT=18202
ExecStart=/home/kojima/exdirect/kuragevp/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 18202
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

