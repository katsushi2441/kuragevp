[Unit]
Description=Kurage Voice Pro API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/kuragevp
Environment=KURAGEVP_PORT=18302
Environment=KURAGEVP_ROOT=/home/kojima/work/kuragevp
Environment=KURAGE_JOBS_DIR=/home/kojima/work/kurage/storage/jobs
Environment=KURAGEVP_WHISPER_DEVICE=cuda
Environment=KURAGEVP_WHISPER_COMPUTE_TYPE=float16
Environment=KURAGEVP_FFMPEG_BIN=/usr/bin/ffmpeg
Environment=KURAGEVP_SUBTITLE_STYLE=FontName=Noto Sans CJK JP,FontSize=30,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BackColour=&H99000000,BorderStyle=3,Outline=1,Shadow=0,Alignment=2,MarginV=58
Environment=LD_LIBRARY_PATH=/home/kojima/work/kuragevp/.venv/lib/python3.10/site-packages/nvidia/cublas/lib:/home/kojima/work/kuragevp/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib:/home/kojima/work/kuragevp/.venv/lib/python3.10/site-packages/nvidia/cuda_nvrtc/lib
ExecStart=/home/kojima/work/kuragevp/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 18302
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
